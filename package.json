{
  "name": "tud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run brands:generate",
    "dev": "next dev",
    "prebuild": "npm run brands:generate",
    "build": "next build",
    "start": "node scripts/preflight-env.mjs && next start",
    "test": "node --test tests/*.test.mjs",
    "test:release": "npm run lint && npx tsc --noEmit && npm run build && npm run test",
    "lint": "eslint app db lib tests --ignore-pattern .next --ignore-pattern dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node scripts/migrate.mjs",
    "deploy:check": "node scripts/preflight-env.mjs",
    "db:studio": "drizzle-kit studio",
    "brands:generate": "node scripts/generate-brand-catalog.mjs",
    "icons:sync": "node scripts/sync-icon-catalog.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "better-auth": "^1.6.25",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "simple-icons": "16.27.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
