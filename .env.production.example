# Public HTTPS hostname. Point its A/AAAA record to this server first.
DOMAIN=tud.example.com
ACME_EMAIL=admin@example.com
BETTER_AUTH_URL=https://tud.example.com
# Optional; defaults to BETTER_AUTH_URL. Useful when the public API URL differs.
TUD_PUBLIC_URL=https://tud.example.com

# Generate both values before deployment:
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-url-safe-random-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
REMINDER_CRON_SECRET=replace-with-another-32-character-random-secret

# Production email delivery is required for registration and password recovery.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=resend
SMTP_PASSWORD=replace-with-resend-api-key
EMAIL_FROM=TuD <no-reply@example.com>
EMAIL_DAILY_LIMIT=100
EMAIL_RECIPIENT_DAILY_LIMIT=3
EMAIL_QUOTA_WHITELIST=admin@example.com
# Defaults to EMAIL_QUOTA_WHITELIST for backwards-compatible personal deployments.
SUBSCRIPTION_REMINDER_EMAILS=admin@example.com
# Optional login-page announcement. Leave empty to hide it.
PUBLIC_AUTH_ANNOUNCEMENT=
