DATABASE_URL=postgresql://nexdue:nexdue@localhost:5432/nexdue
BETTER_AUTH_URL=http://localhost:3000
# Optional public URL advertised by local development (for example, a hosted personal instance).
TUD_PUBLIC_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
REMINDER_CRON_SECRET=replace-with-another-32-character-random-secret

# SMTP is required in production for registration and email changes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=TuD <no-reply@example.com>
EMAIL_DAILY_LIMIT=100
EMAIL_RECIPIENT_DAILY_LIMIT=3
EMAIL_QUOTA_WHITELIST=
# Comma-separated accounts allowed to enable subscription reminder emails.
# Falls back to EMAIL_QUOTA_WHITELIST when omitted.
SUBSCRIPTION_REMINDER_EMAILS=
# Optional login-page announcement. Leave empty to hide it.
PUBLIC_AUTH_ANNOUNCEMENT=
